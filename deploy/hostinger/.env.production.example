# Names only — set real values in Hostinger Docker Manager Environment panel.
# Never commit secrets.

APP_NAME=Phumpanya
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://plenglnw1.tech
APP_HOST=plenglnw1.tech
WWW_HOST=www.plenglnw1.tech
FRONTEND_URL=https://plenglnw1.tech
SANCTUM_STATEFUL_DOMAINS=plenglnw1.tech,www.plenglnw1.tech

TRAEFIK_ENABLE=true
TRAEFIK_NETWORK=traefik

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=phumpanya
DB_USERNAME=phumpanya
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

QDRANT_ENABLED=false
GEMINI_ENABLED=false
GEMINI_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://plenglnw1.tech/auth/google/callback
AUTH_PASSWORD_LOGIN_ENABLED=true
AUTH_PASSWORD_REGISTER_ENABLED=false

SEED_DEMO_DATA=false

FRONTEND_IMAGE=ghcr.io/chissanupun/ku-bcg-frontend:latest
LARAVEL_IMAGE=ghcr.io/plenglnw1/ku-phumpanya:latest
GATEWAY_IMAGE=ghcr.io/plenglnw1/ku-phumpanya-gateway:latest
SEARCH_INIT_IMAGE=ghcr.io/chissanupun/ku-bcg-search-init:latest

# Hostinger Docker Manager first boot — set false after migrate succeeds
RUN_MIGRATIONS_ON_START=true

LOG_CHANNEL=stderr
LOG_LEVEL=warning
